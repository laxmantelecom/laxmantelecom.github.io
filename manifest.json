{
  "name": "Laxman Telecom",
  "short_name": "Laxman Telecom",
  "description": "Your Trusted Digital Service Center - Mobile Repair, Recharge, Aadhaar, PAN Card and more.",
  "start_url": "index.html",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#143c7e",
  "theme_color": "#0d2a5c",
  "icons": [
    {
      "src": "pwa-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "pwa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "pwa-icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "pwa-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "scope_extensions": [
    { "origin": "*.whatsapp.com" },
    { "origin": "*.google.com" }
  ],
  "handle_links": "auto",
  "display_override": ["window-controls-overlay"]
}
